# =========================================================================
# Rider Stack Environment Variables Example
# Duplicate this file as .env and update the values for production deployment.
# =========================================================================

# Database Config (Used by docker-compose to spin up PostgreSQL container)
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=rider_db

# Backend App Configuration
JWT_SECRET=your_production_super_secret_jwt_key
JWT_EXPIRES_IN=15m
PORT=3000

# Payment Gateways
PAYSTACK_SECRET=sk_live_your_paystack_secret_key

# Cloudflare R2 / AWS S3 Object Storage (For image uploads)
R2_BUCKET_NAME=rider-logistics-uploads
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key

# Next.js Admin Panel Configuration
NEXT_PUBLIC_API_URL=/api
PORT_ADMIN=3001
